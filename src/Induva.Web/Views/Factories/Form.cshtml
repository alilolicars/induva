@model FactoryFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? $"Edit Factory - {Model.Name}" : "Register New Factory";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0">@(isEdit ? "Edit Factory Profile" : "Register Factory")</h3>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
                </div>
                <p class="text-muted small mb-4">
                    Provide accurate equipment and capacity details to enable accurate AI suggestions and partner matching.
                </p>

                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label small fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Delta Tomato Canning Co." autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Sector" class="form-label small fw-semibold"></label>
                            <select asp-for="Sector" asp-items="Html.GetEnumSelectList<Sector>()" class="form-select"></select>
                            <span asp-validation-for="Sector" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="GovernorateId" class="form-label small fw-semibold"></label>
                            <select asp-for="GovernorateId" asp-items="Model.Governorates" class="form-select">
                                <option value="">Select Governorate...</option>
                            </select>
                            <span asp-validation-for="GovernorateId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UtilizationPercent" class="form-label small fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="UtilizationPercent" type="number" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="UtilizationPercent" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe your manufacturing operations, facility size, key products, and certifications..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label small fw-semibold">Latitude (Optional, defaults to governorate center)</label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" placeholder="e.g. 30.5877" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label small fw-semibold">Longitude (Optional)</label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" placeholder="e.g. 31.5020" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsPublic" class="form-check-input" />
                        <label asp-for="IsPublic" class="form-check-label small"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">@(isEdit ? "Save Changes" : "Create Factory")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

