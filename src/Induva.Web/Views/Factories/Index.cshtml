@model PagedResult<FactoryListItemDto>
@{
    ViewData["Title"] = "Factory Directory";
    var filter = ViewBag.Filter as FactoryFilter ?? new FactoryFilter();
    var governorates = ViewBag.Governorates as IEnumerable<SelectListItem> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">Factory Directory</h2>
        <p class="text-muted small mb-0">Discover verified Egyptian manufacturing plants and production capabilities.</p>
    </div>
    @if (User.IsInRole(Roles.FactoryOwner) || User.IsInRole(Roles.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ Register Factory</a>
    }
</div>

<!-- Search & Filter Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search Keywords</label>
                <input type="text" name="Q" value="@filter.Q" class="form-control form-control-sm" placeholder="Factory name..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Governorate</label>
                <select name="GovernorateId" class="form-select form-select-sm">
                    <option value="">All Governorates</option>
                    @foreach (var g in governorates)
                    {
                        <option value="@g.Value" selected="@(g.Value == filter.GovernorateId?.ToString())">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Sector</label>
                <select name="Sector" class="form-select form-select-sm">
                    <option value="">All Sectors</option>
                    @foreach (var s in Enum.GetValues<Sector>())
                    {
                        <option value="@s" selected="@(s == filter.Sector)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results Grid -->
@if (Model.Items.Count == 0)
{
    <div class="alert alert-info shadow-sm p-4 text-center">
        <h5>No factories found</h5>
        <p class="text-muted mb-0">Try adjusting your filters or register a new factory profile.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary-subtle text-secondary border">@item.Sector</span>
                            <span class="badge bg-light text-dark border">📍 @item.GovernorateName</span>
                        </div>
                        <h5 class="card-title fw-bold mb-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                @item.Name
                            </a>
                        </h5>
                        <p class="card-text text-muted small mt-2 mb-3">
                            Capacity Utilization: <strong>@item.UtilizationPercent%</strong>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(item.UtilizationPercent > 80 ? "bg-warning" : "bg-success")"
                                     role="progressbar" style="width: @item.UtilizationPercent%"></div>
                            </div>
                        </p>
                        <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top">
                            <span>⚙️ @item.MachineCount @(item.MachineCount == 1 ? "machine" : "machines")</span>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View Details &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Paging -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Factory pagination">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-Page="@i"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-GovernorateId="@filter.GovernorateId"
                           asp-route-Sector="@filter.Sector"
                           asp-route-Q="@filter.Q">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

