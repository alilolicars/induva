@model PagedResult<DemandRequestListItemDto>
@{
    ViewData["Title"] = "Open Demand & RFQs";
    var filter = ViewBag.Filter as DemandRequestFilter ?? new DemandRequestFilter();
    var governorates = ViewBag.Governorates as IEnumerable<SelectListItem> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold mb-1">Open Demand & Procurement RFQs</h1>
        <p class="text-muted mb-0">Browse real procurement inquiries and manufacturing purchase requests from domestic and international buyers.</p>
    </div>
    @if (User.IsInRole(Roles.Buyer) || User.IsInRole(Roles.FactoryOwner) || User.IsInRole(Roles.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ Post Demand Request</a>
    }
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Search Product / Request</label>
                <input type="text" name="Q" value="@filter.Q" class="form-control form-control-sm" placeholder="e.g. Glass bottles, cardboard..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Sector</label>
                <select name="Sector" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Sector>()">
                    <option value="">All Sectors</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Governorate</label>
                <select name="GovernorateId" class="form-select form-select-sm">
                    <option value="">All Governorates</option>
                    @foreach (var g in governorates)
                    {
                        <option value="@g.Value" selected="@(filter.GovernorateId?.ToString() == g.Value)">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Export Flag</label>
                <select name="IsExport" class="form-select form-select-sm">
                    <option value="">All Requests</option>
                    <option value="true" selected="@(filter.IsExport == true)">Export Orders Only</option>
                    <option value="false" selected="@(filter.IsExport == false)">Domestic Orders Only</option>
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="Open" selected="@(filter.Status == "Open")">Open</option>
                    <option value="Closed" selected="@(filter.Status == "Closed")">Closed</option>
                    <option value="" selected="@(string.IsNullOrEmpty(filter.Status))">All</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <div class="display-6 mb-2">📑</div>
        <h5 class="fw-bold">No demand requests found</h5>
        <p class="text-muted mb-3">Try adjusting your filters or search terms.</p>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Clear Filters</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var d in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 hover-lift">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">
                                <a asp-action="Details" asp-route-id="@d.Id" class="text-decoration-none text-dark stretched-link">
                                    @d.Title
                                </a>
                            </h5>
                            @if (d.IsExport)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border">🌍 Export Order</span>
                            }
                        </div>
                        <p class="text-muted small mb-2">
                            <span class="badge bg-primary-subtle text-primary border">@d.Sector</span>
                            <span class="mx-1">·</span>
                            <span>📍 @d.GovernorateName</span>
                        </p>
                        <div class="bg-light p-2 rounded mb-2 small">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Target Product:</span>
                                <span class="fw-semibold">@d.ProductName</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Volume:</span>
                                <strong>@d.Quantity.ToString("N0") @d.Unit</strong>
                            </div>
                            @if (d.TargetPriceEgp.HasValue)
                            {
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Target Price:</span>
                                    <span class="text-success fw-semibold">@d.TargetPriceEgp.Value.ToString("N2") EGP / @d.Unit</span>
                                </div>
                            }
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
                            <span>Status: <strong class="@(d.Status == "Open" ? "text-success" : "text-secondary")">@d.Status</strong></span>
                            <span class="text-primary fw-semibold">View RFQ &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@p"
                           asp-route-q="@filter.Q"
                           asp-route-sector="@filter.Sector"
                           asp-route-governorateId="@filter.GovernorateId"
                           asp-route-isExport="@filter.IsExport"
                           asp-route-status="@filter.Status">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

