@model AdminDashboardDto
@{
    ViewData["Title"] = "Admin Operations & Telemetry";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold mb-1">🛡️ Administration & Platform Telemetry</h1>
        <p class="text-muted mb-0">Platform overview, user accounts, and AI module execution telemetry.</p>
    </div>
    <div class="d-flex gap-2">
        <button id="btn-ping-ai" class="btn btn-outline-primary btn-sm">
            ⚡ Ping AI Provider
        </button>
        <a asp-controller="GovernorateResources" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            🗺️ Manage Governorate Resources
        </a>
    </div>
</div>

<div id="ai-health-alert" class="mb-3 d-none"></div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-primary">@Model.Counts.TotalUsers</span>
            <span class="small text-muted">Registered Users</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-dark">@Model.Counts.TotalFactories</span>
            <span class="small text-muted">Factories</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-success">@Model.Counts.TotalSuppliers</span>
            <span class="small text-muted">Suppliers</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-warning-emphasis">@Model.Counts.TotalStartups</span>
            <span class="small text-muted">Startups</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-info-emphasis">@Model.Counts.TotalInvestors</span>
            <span class="small text-muted">Investors</span>
        </div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card shadow-sm border-0 text-center p-3">
            <span class="display-6 fw-bold text-secondary">@Model.Counts.TotalOpenDemands</span>
            <span class="small text-muted">Open RFQs</span>
        </div>
    </div>
</div>

<!-- AI Telemetry Grid -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">🤖 AI Execution & Latency Telemetry</h6>
            </div>
            <div class="card-body">
                <div class="row g-2 text-center mb-3">
                    <div class="col-4">
                        <div class="p-2 border rounded bg-light">
                            <span class="fs-5 fw-bold text-primary">@Model.AiStats.TotalRuns</span>
                            <span class="d-block small text-muted">Total Invocations</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded bg-light">
                            <span class="fs-5 fw-bold text-success">@Model.AiStats.SuccessfulRuns</span>
                            <span class="d-block small text-muted">Successful</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 border rounded bg-light">
                            <span class="fs-5 fw-bold @(Model.AiStats.FailedRuns > 0 ? "text-danger" : "text-muted")">@Model.AiStats.FailedRuns</span>
                            <span class="d-block small text-muted">Failed</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">Average Provider Latency:</span>
                    <strong>@Model.AiStats.AverageLatencyMs ms</strong>
                </div>

                <h6 class="fw-bold small text-muted mt-3 mb-2">Invocations by AI Feature</h6>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var f in Model.AiStats.RunsByFeature)
                    {
                        <span class="badge bg-primary-subtle text-primary border p-2">
                            @f.Key: <strong>@f.Value</strong>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">📅 AI Runs (Last 7 Days)</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Date</th>
                                <th class="text-end">Calls</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.AiStats.Last7Days)
                            {
                                <tr>
                                    <td>@d.Date</td>
                                    <td class="text-end fw-bold">@d.RunCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Users Management Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0">👥 User Accounts & Access Control (@Model.Users.Count)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Email / Identity</th>
                        <th>Display Name</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th style="width: 130px;" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Email</td>
                            <td>@(u.DisplayName ?? "-")</td>
                            <td>
                                @foreach (var r in u.Roles)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border me-1">@r</span>
                                }
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked Out</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="ToggleLockout" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm @(u.IsLockedOut ? "btn-outline-success" : "btn-outline-danger") py-0 px-2">
                                        @(u.IsLockedOut ? "Unlock" : "Lock")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Recent AI Audit Runs -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0">📜 Recent AI Runs Audit Log (Last 50 - No raw prompt disclosure)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>Run ID</th>
                        <th>Feature</th>
                        <th>Target Entity</th>
                        <th>Latency</th>
                        <th>Cache</th>
                        <th>Status</th>
                        <th>Timestamp (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentRuns.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3 text-muted">No AI runs recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model.RecentRuns)
                        {
                            <tr>
                                <td>#@r.Id</td>
                                <td><span class="badge bg-light text-dark border">@r.Feature</span></td>
                                <td>@r.EntityType #@r.EntityId</td>
                                <td>@r.LatencyMs ms</td>
                                <td>
                                    @if (r.FromCache)
                                    {
                                        <span class="badge bg-info text-dark">Cache Hit</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Live</span>
                                    }
                                </td>
                                <td>
                                    @if (r.Success)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="@r.Error">Failed</span>
                                    }
                                </td>
                                <td class="text-muted">@r.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btn-ping-ai')?.addEventListener('click', async () => {
            const btn = document.getElementById('btn-ping-ai');
            const alertBox = document.getElementById('ai-health-alert');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Pinging Provider...';
            alertBox.className = 'd-none';

            try {
                const res = await fetch('/Admin/AiHealth');
                const data = await res.json();

                alertBox.className = res.ok
                    ? 'alert alert-success shadow-sm d-flex justify-content-between align-items-center'
                    : 'alert alert-danger shadow-sm d-flex justify-content-between align-items-center';

                alertBox.innerHTML = `
                    <span><strong>Provider Status:</strong> ${data.status} · Latency: <strong>${data.latencyMs} ms</strong></span>
                    <small class="text-muted">${data.timestampUtc}</small>
                `;
            } catch (err) {
                alertBox.className = 'alert alert-danger shadow-sm';
                alertBox.textContent = `Provider Ping Failed: ${err.message}`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '⚡ Ping AI Provider';
            }
        });
    </script>
}
