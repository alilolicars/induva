@{
    ViewData["Title"] = "INDUVA — Egypt's Industrial & Investment Platform";
    ViewData["IsLandingPage"] = true;
}

<!-- 2. Breathable Hero Section with 1-Click Case Study Switcher -->
<header class="hero-wrapper">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Left Column: Clear Value Proposition -->
            <div class="col-lg-6">
                <!-- <div class="hero-pill">
                    <span class="hero-pill-dot"></span>
                    <span>Industrial &amp; Investment Network across 27 Governorates</span>
                </div> -->

                <h1 class="hero-headline">
                    Turn <em>idle factory lines</em> into profitable new products &amp; partnerships.
                </h1>

                <p class="hero-subtext">
                    INDUVA connects Egypt's factories, local raw-material suppliers, startups, buyers, and investors—helping
                    factories discover what else their machines can make during off-seasons and validating the numbers before
                    investing.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Map" asp-action="Index" class="btn-primary-induva">
                        <span>Explore Resource Map</span>
                        <span>→</span>
                    </a>
                    <a asp-controller="Factories" asp-action="Index" class="btn-secondary-induva">
                        <span>Browse Factories</span>
                    </a>
                </div>

                <div class="trust-metrics">
                    <div>
                        <div class="trust-metric-num">27</div>
                        <div class="trust-metric-label">Governorates Mapped</div>
                    </div>
                    <div>
                        <div class="trust-metric-num">5 Roles</div>
                        <div class="trust-metric-label">Factories, Suppliers, Startups, Buyers &amp; Investors</div>
                    </div>
                    <div>
                        <div class="trust-metric-num">3-Scenario</div>
                        <div class="trust-metric-label">Instant Payback &amp; ROI Calculator</div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Clean Interactive Story Card -->
            <div class="col-lg-6">
                <div class="story-showcase-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold text-secondary">Real Platform Scenarios</span>
                        <span class="badge-soft badge-emerald">Interactive Preview</span>
                    </div>

                    <!-- 3 Golden Factory Story Tabs -->
                    <div class="story-tabs" id="storySwitcher" role="tablist">
                        <button type="button" class="story-tab-btn active" data-story="tomato">Sharqia Canning</button>
                        <button type="button" class="story-tab-btn" data-story="plastics">10th Plastics</button>
                        <button type="button" class="story-tab-btn" data-story="sugar">Aswan Sugar Mill</button>
                    </div>

                    <div class="story-body" id="storyContent">
                        <!-- Factory Header -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="h5 fw-bold mb-1" id="stName">Delta Tomato Canning Co.</h4>
                                <div class="small text-secondary" id="stLocation">Sharqia Governorate · Food Processing</div>
                            </div>
                            <span class="badge-soft badge-terracotta" id="stIdle">80% Idle (Oct–Feb)</span>
                        </div>

                        <!-- Step 1: Current Situation -->
                        <div class="flow-box">
                            <div class="flow-step-label">1. Existing Equipment &amp; Off-Season Gap</div>
                            <div class="small text-dark" id="stMachines">
                                Retort sterilizers, vacuum evaporators, and can seamers sit 80% underutilized for 5 months after the
                                summer tomato harvest.
                            </div>
                        </div>

                        <!-- Step 2: Recommended Opportunity -->
                        <div class="flow-box">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="flow-step-label mb-0">2. Suggested Off-Season Product</div>
                                <span class="badge-soft badge-amber" id="stPeak">Peaks Pre-Ramadan</span>
                            </div>
                            <div class="fw-bold mt-1" id="stProduct">Ready-to-Eat Fava Beans &amp; Legume Canning</div>
                            <div class="small text-secondary mt-1" id="stMatch">
                                Uses 100% existing canning lines · Matched with 2 local suppliers &amp; an open Port Said export
                                request.
                            </div>
                        </div>

                        <!-- Step 3: Financial Snapshot -->
                        <div class="outcome-kpi-row">
                            <div class="outcome-kpi-box">
                                <div class="outcome-kpi-val" id="stMargin">28.6%</div>
                                <div class="outcome-kpi-caption">Est. Unit Margin</div>
                            </div>
                            <div class="outcome-kpi-box">
                                <div class="outcome-kpi-val" id="stPayback">7 Months</div>
                                <div class="outcome-kpi-caption">Est. Payback</div>
                            </div>
                            <div class="outcome-kpi-box">
                                <div class="outcome-kpi-val text-success" id="stRoi">+184%</div>
                                <div class="outcome-kpi-caption">3-Year ROI</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <span class="small text-muted" style="font-size: 0.76rem;">
                                Indicative AI &amp; financial model estimate
                            </span>
                            <a href="/Factories/Details/1" id="stLink" class="small fw-semibold text-decoration-none"
                               style="color: var(--accent-terracotta);">
                                View Factory Profile →
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</header>

<!-- 3. How INDUVA Works (4 Clear, Jargon-Free Steps) -->
<section class="section-block" style="background-color: var(--bg-subtle);">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-5" style="max-width: 640px;">
            <span class="section-eyebrow">How It Works</span>
            <h2 class="section-title">From Idle Machines to Verified Deals in Four Steps</h2>
            <p class="text-secondary mb-0">
                Whether you own a factory with seasonal downtime or a startup looking for a production line, INDUVA guides
                every decision with grounded data.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="step-card">
                    <div class="step-number-circle">01</div>
                    <h3 class="h5 fw-bold mb-2">Map Capabilities</h3>
                    <p class="small text-secondary mb-0">
                        Factories list their machines, capacities, and idle months. INDUVA translates your equipment into
                        standardized manufacturing capabilities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="step-card">
                    <div class="step-number-circle">02</div>
                    <h3 class="h5 fw-bold mb-2">Discover Products</h3>
                    <p class="small text-secondary mb-0">
                        Get up to 5 alternative product ideas tailored to your exact machines, nearby governorate raw materials,
                        and seasonal demand waves.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="step-card">
                    <div class="step-number-circle">03</div>
                    <h3 class="h5 fw-bold mb-2">Simulate ROI &amp; Costs</h3>
                    <p class="small text-secondary mb-0">
                        Test Conservative, Base, and Optimistic financial scenarios. Edit prices, volumes, or costs anytime to
                        recalculate payback and break-even instantly.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="step-card">
                    <div class="step-number-circle">04</div>
                    <h3 class="h5 fw-bold mb-2">Match &amp; Connect</h3>
                    <p class="small text-secondary mb-0">
                        Get ranked matches with raw-material suppliers, buyers with open RFQs, startups needing production, and
                        sector-aligned investors.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. Clean Tabbed Opportunity Explorer -->
<section class="section-block">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end mb-4 gap-3">
            <div>
                <span class="section-eyebrow">Live Directory Preview</span>
                <h2 class="section-title mb-0">Explore Egypt's Industrial Network</h2>
            </div>

            <div class="filter-pill-bar" id="directoryTabs">
                <button type="button" class="filter-pill-btn active" data-category="factories">Factories</button>
                <button type="button" class="filter-pill-btn" data-category="demand">Buyer Requests (RFQs)</button>
                <button type="button" class="filter-pill-btn" data-category="suppliers">Raw Suppliers</button>
                <button type="button" class="filter-pill-btn" data-category="startups">Startups</button>
            </div>
        </div>

        <!-- 3 Airy Cards Rendered Cleanly via JS -->
        <div class="row g-4" id="opportunityGrid"></div>

        <div class="text-center mt-5">
            <a asp-controller="Map" asp-action="Index" class="btn-secondary-induva">
                <span>Open Full Interactive Map (All 27 Governorates)</span>
                <span>↗</span>
            </a>
        </div>
    </div>
</section>

<!-- 5. Role-Based Onboarding Banner -->
<section class="pb-5">
    <div class="container">
        <div class="roles-surface">
            <div class="row align-items-end mb-4">
                <div class="col-lg-7">
                    <span class="section-eyebrow" style="color: #f39c73;">Join the Ecosystem</span>
                    <h2 class="font-display h2 fw-semibold mb-1">Built for Every Side of Egyptian Industry</h2>
                    <p class="mb-0" style="color: rgba(255,255,255,0.72);">
                        Choose your role to create your profile and start matching in minutes.
                    </p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6 col-lg">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="FactoryOwner" class="role-portal-card">
                        <div>
                            <div class="small fw-semibold mb-2" style="color: #f39c73;">Factory Owner</div>
                            <p class="small mb-3" style="color: rgba(255,255,255,0.75);">
                                Fill seasonal downtime, discover alternative products, and find verified buyers.
                            </p>
                        </div>
                        <span class="small fw-semibold">Register Factory →</span>
                    </a>
                </div>

                <div class="col-md-6 col-lg">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Supplier" class="role-portal-card">
                        <div>
                            <div class="small fw-semibold mb-2" style="color: #f39c73;">Raw Supplier</div>
                            <p class="small mb-3" style="color: rgba(255,255,255,0.75);">
                                List agricultural, mineral, or chemical materials and connect with nearby plants.
                            </p>
                        </div>
                        <span class="small fw-semibold">Register Supplier →</span>
                    </a>
                </div>

                <div class="col-md-6 col-lg">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Startup" class="role-portal-card">
                        <div>
                            <div class="small fw-semibold mb-2" style="color: #f39c73;">Startup Founder</div>
                            <p class="small mb-3" style="color: rgba(255,255,255,0.75);">
                                Manufacture your product on existing factory lines without building a plant from scratch.
                            </p>
                        </div>
                        <span class="small fw-semibold">Register Startup →</span>
                    </a>
                </div>

                <div class="col-md-6 col-lg">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Investor" class="role-portal-card">
                        <div>
                            <div class="small fw-semibold mb-2" style="color: #f39c73;">Investor</div>
                            <p class="small mb-3" style="color: rgba(255,255,255,0.75);">
                                Explore de-risked manufacturing expansions and startups with transparent unit economics.
                            </p>
                        </div>
                        <span class="small fw-semibold">Register Investor →</span>
                    </a>
                </div>

                <div class="col-md-12 col-lg">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Buyer" class="role-portal-card">
                        <div>
                            <div class="small fw-semibold mb-2" style="color: #f39c73;">Buyer / Exporter</div>
                            <p class="small mb-3" style="color: rgba(255,255,255,0.75);">
                                Post custom manufacturing requests (RFQs) and get matched with capable Egyptian factories.
                            </p>
                        </div>
                        <span class="small fw-semibold">Post a Request →</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // 1. Hero Case Study Data (Golden Factories from Spec)
        const stories = {
            tomato: {
                name: "Delta Tomato Canning Co.",
                location: "Sharqia Governorate · Food Processing",
                idle: "80% Idle (Oct–Feb)",
                machines: "Retort sterilizers, vacuum evaporators, and can seamers sit 80% underutilized for 5 months after the summer tomato harvest.",
                peak: "Peaks Pre-Ramadan",
                product: "Ready-to-Eat Fava Beans & Legume Canning",
                match: "Uses 100% existing canning lines · Matched with 2 local suppliers & an open Port Said export request.",
                margin: "28.6%",
                payback: "7 Months",
                roi: "+184%",
                link: "@Url.Action("Details", "Factories", new { id = 1 })"
            },
            plastics: {
                name: "Tenth Plastics",
                location: "Sharqia Governorate · Plastics & Packaging",
                idle: "25% Idle (Dec–Feb)",
                machines: "Six injection-molding lines (150T & 250T) and a single-screw extruder have spare winter capacity.",
                peak: "High Harvest Demand",
                product: "Ventilated Agricultural Crates (Recycled HDPE)",
                match: "Matched with Qalyubia recycled plastic flakes supplier & a 5,000-crate buyer request in Dakahlia.",
                margin: "31.2%",
                payback: "5 Months",
                roi: "+212%",
                link: "@Url.Action("Details", "Factories", new { id = 3 })"
            },
            sugar: {
                name: "Kom Ombo Sugar Mill",
                location: "Aswan Governorate · Agro-Processing",
                idle: "90% Idle (Jun–Dec)",
                machines: "Industrial evaporators, boilers, and centrifuges sit idle between June and December outside sugarcane season.",
                peak: "Export & Autumn Peak",
                product: "Concentrated Date Syrup (Dibs) & Liquid Sweeteners",
                match: "Sources abundant Aswan dates locally · Low transport cost and high autumn confectionery demand.",
                margin: "24.0%",
                payback: "9 Months",
                roi: "+143%",
                link: "@Url.Action("Details", "Factories", new { id = 6 })"
            }
        };

        const storyContent = document.getElementById("storyContent");

        function updateStory(key) {
            const s = stories[key];
            if (!s || !storyContent) return;

            storyContent.classList.add("fade-out");
            setTimeout(() => {
                const elName = document.getElementById("stName");
                const elLoc = document.getElementById("stLocation");
                const elIdle = document.getElementById("stIdle");
                const elMach = document.getElementById("stMachines");
                const elPeak = document.getElementById("stPeak");
                const elProd = document.getElementById("stProduct");
                const elMatch = document.getElementById("stMatch");
                const elMargin = document.getElementById("stMargin");
                const elPayback = document.getElementById("stPayback");
                const elRoi = document.getElementById("stRoi");
                const elLink = document.getElementById("stLink");

                if (elName) elName.textContent = s.name;
                if (elLoc) elLoc.textContent = s.location;
                if (elIdle) elIdle.textContent = s.idle;
                if (elMach) elMach.textContent = s.machines;
                if (elPeak) elPeak.textContent = s.peak;
                if (elProd) elProd.textContent = s.product;
                if (elMatch) elMatch.textContent = s.match;
                if (elMargin) elMargin.textContent = s.margin;
                if (elPayback) elPayback.textContent = s.payback;
                if (elRoi) elRoi.textContent = s.roi;
                if (elLink) elLink.href = s.link;

                storyContent.classList.remove("fade-out");
            }, 150);
        }

        const storySwitcher = document.getElementById("storySwitcher");
        if (storySwitcher) {
            storySwitcher.addEventListener("click", (e) => {
                const btn = e.target.closest("[data-story]");
                if (!btn) return;
                document.querySelectorAll("#storySwitcher .story-tab-btn").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                updateStory(btn.dataset.story);
            });
        }

        // 2. Tabbed Directory Preview Data
        const directoryData = {
            factories: [
                {
                    badge: "Sharqia · الشرقية",
                    status: "80% Idle Oct–Feb",
                    title: "Delta Tomato Canning Co.",
                    desc: "Equipped with washing lines, hot-break pulpers, vacuum evaporators, and retort sterilizers.",
                    tags: ["fruit-vegetable-processing", "canning", "food-packaging"],
                    linkText: "View Factory",
                    url: "@Url.Action("Details", "Factories", new { id = 1 })"
                },
                {
                    badge: "Gharbia · الغربية",
                    status: "30% Idle Jan–Feb",
                    title: "Mahalla Garment Works",
                    desc: "120 industrial sewing machines, 30 overlock units, cutting tables, and steam finishing lines.",
                    tags: ["garment-sewing", "textile-spinning"],
                    linkText: "View Factory",
                    url: "@Url.Action("Details", "Factories", new { id = 2 })"
                },
                {
                    badge: "Suez · السويس",
                    status: "40% Idle Jan–Feb",
                    title: "Ain Sokhna Ceramics",
                    desc: "Full ball mill, spray dryer, hydraulic press, and tunnel kiln line near Red Sea minerals.",
                    tags: ["ceramic-firing", "stone-cutting"],
                    linkText: "View Factory",
                    url: "@Url.Action("Details", "Factories", new { id = 4 })"
                }
            ],
            demand: [
                {
                    badge: "Giza · الجيزة",
                    status: "200,000 pcs · Open",
                    title: "500ml Food-Grade Plastic Containers",
                    desc: "Seeking a local injection-molding partner for recurring monthly food packaging supply.",
                    tags: ["injection-molding", "food-packaging"],
                    linkText: "View Request",
                    url: "@Url.Action("Details", "DemandRequests", new { id = 2 })"
                },
                {
                    badge: "Port Said · بورسعيد",
                    status: "Export Order · Open",
                    title: "Sterilized Canned Vegetables Pallet",
                    desc: "Export-ready canned legume and vegetable batch required with retort sterilization.",
                    tags: ["canning", "fruit-vegetable-processing"],
                    linkText: "View Request",
                    url: "@Url.Action("Details", "DemandRequests", new { id = 6 })"
                },
                {
                    badge: "Alexandria · الإسكندرية",
                    status: "20,000 pcs · Open",
                    title: "Durable School Uniform Batch",
                    desc: "Seasonal contract manufacturing order before the autumn academic term.",
                    tags: ["garment-sewing"],
                    linkText: "View Request",
                    url: "@Url.Action("Details", "DemandRequests", new { id = 3 })"
                }
            ],
            suppliers: [
                {
                    badge: "Qalyubia · القليوبية",
                    status: "Min Order: 5 Tons",
                    title: "Nile Recycled Plastic Flakes",
                    desc: "Washed, sorted HDPE and PP recycled flakes ready for injection molding and extrusion.",
                    tags: ["Recycled plastic", "Polymers (resin)"],
                    linkText: "View Supplier",
                    url: "@Url.Action("Details", "Suppliers", new { id = 6 })"
                },
                {
                    badge: "Red Sea · البحر الأحمر",
                    status: "Min Order: 25 Tons",
                    title: "Eastern Desert Clay & Kaolin Co.",
                    desc: "High-purity kaolin, feldspar, and silica sand for ceramics and glass factories.",
                    tags: ["Kaolin", "Clay", "Silica sand"],
                    linkText: "View Supplier",
                    url: "@Url.Action("Details", "Suppliers", new { id = 4 })"
                },
                {
                    badge: "Beheira · البحيرة",
                    status: "Seasonal Contract",
                    title: "Delta Agro Tomato Cooperative",
                    desc: "Direct farm-gate supply of processing tomatoes and citrus for food factories.",
                    tags: ["Tomatoes", "Citrus"],
                    linkText: "View Supplier",
                    url: "@Url.Action("Details", "Suppliers", new { id = 3 })"
                }
            ],
            startups: [
                {
                    badge: "Prototype Stage",
                    status: "Needs 1.2M EGP",
                    title: "EcoPack — Recycled Reusable Crates",
                    desc: "Looking for an injection-molding factory with idle winter capacity to produce our first 15,000 units.",
                    tags: ["injection-molding", "plastic-recycling"],
                    linkText: "View Startup",
                    url: "@Url.Action("Details", "Startups", new { id = 1 })"
                },
                {
                    badge: "Early Revenue",
                    status: "Needs 2.5M EGP",
                    title: "NileHarvest — Ready Artisanal Sauces",
                    desc: "Scaling distribution and seeking a food-processing plant with glass-jar filling and canning lines.",
                    tags: ["fruit-vegetable-processing", "canning"],
                    linkText: "View Startup",
                    url: "@Url.Action("Details", "Startups", new { id = 4 })"
                },
                {
                    badge: "MVP Stage",
                    status: "Needs 800K EGP",
                    title: "PalmPaper — Agri-Waste Packaging",
                    desc: "Converting agricultural fiber into molded paper trays with local paper-converting partners.",
                    tags: ["paper-converting", "food-packaging"],
                    linkText: "View Startup",
                    url: "@Url.Action("Details", "Startups", new { id = 2 })"
                }
            ]
        };

        const grid = document.getElementById("opportunityGrid");

        function renderDirectoryCards(category) {
            if (!grid) return;
            const items = directoryData[category] || [];
            grid.replaceChildren();

            items.forEach(item => {
                const col = document.createElement("div");
                col.className = "col-md-6 col-lg-4";

                const card = document.createElement("div");
                card.className = "opportunity-card";

                const top = document.createElement("div");

                const metaRow = document.createElement("div");
                metaRow.className = "d-flex justify-content-between align-items-center mb-3";

                const locBadge = document.createElement("span");
                locBadge.className = "small fw-semibold text-secondary";
                locBadge.textContent = item.badge;

                const statusBadge = document.createElement("span");
                statusBadge.className = "badge-soft badge-emerald";
                statusBadge.textContent = item.status;

                metaRow.append(locBadge, statusBadge);

                const title = document.createElement("h4");
                title.className = "h5 fw-bold mb-2";
                title.textContent = item.title;

                const desc = document.createElement("p");
                desc.className = "small text-secondary mb-3";
                desc.textContent = item.desc;

                const tagWrap = document.createElement("div");
                tagWrap.className = "mb-3";
                item.tags.forEach(t => {
                    const chip = document.createElement("span");
                    chip.className = "tag-pill-clean";
                    chip.textContent = t;
                    tagWrap.appendChild(chip);
                });

                top.append(metaRow, title, desc, tagWrap);

                const bottom = document.createElement("div");
                bottom.className = "pt-3 border-top d-flex justify-content-between align-items-center";

                const link = document.createElement("a");
                link.href = item.url;
                link.className = "small fw-bold text-decoration-none";
                link.style.color = "var(--accent-terracotta)";
                link.textContent = `${item.linkText} →`;

                bottom.appendChild(link);
                card.append(top, bottom);
                col.appendChild(card);
                grid.appendChild(col);
            });
        }

        const directoryTabs = document.getElementById("directoryTabs");
        if (directoryTabs) {
            directoryTabs.addEventListener("click", (e) => {
                const btn = e.target.closest("[data-category]");
                if (!btn) return;
                document.querySelectorAll("#directoryTabs .filter-pill-btn").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                renderDirectoryCards(btn.dataset.category);
            });
        }

        // Initial render
        renderDirectoryCards("factories");
    </script>
}
