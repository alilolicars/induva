<!-- SECTION 4: HOW IT WORKS (Beige background removed from behind each image) -->
<section class="py-5" style="background-color: #F6F4EF; padding-top: 64px !important; padding-bottom: 80px !important;">
    <div class="container" style="max-width: 1200px;">
        <div class="text-center mb-5">
            <span class="eyebrow d-block mb-2">HOW IT WORKS</span>
            <h2 class="fw-bold" style="font-size: 30px; line-height: 36px; color: #0E1B24;">
                From machine list to matched partners in three steps
            </h2>
        </div>

        <div class="row g-4">
            <!-- Step 01 -->
            <div class="col-md-4">
                <div class="card-induva h-100 d-flex flex-column text-start">
                    <div class="mb-3 text-center p-2 rounded-3">
                        <img src="~/images/landing/step-01-factory.webp" alt="Profile factory" class="img-fluid" style="max-height: 140px; object-fit: contain;" />
                    </div>
                    <div class="font-mono fw-bold mb-2" style="font-size: 28px; color: #0B5563;">01</div>
                    <h3 class="fw-semibold mb-2" style="font-size: 20px; line-height: 28px; color: #0E1B24;">Profile your factory</h3>
                    <p class="text-muted mb-0" style="font-size: 15px; line-height: 24px; color: #5B6670;">
                        Add machines, products and the months your lines sit idle.
                    </p>
                </div>
            </div>

            <!-- Step 02 -->
            <div class="col-md-4">
                <div class="card-induva h-100 d-flex flex-column text-start">
                    <div class="mb-3 text-center p-2 rounded-3">
                        <img src="~/images/landing/step-02-analysis.webp" alt="AI analysis" class="img-fluid" style="max-height: 140px; object-fit: contain;" />
                    </div>
                    <div class="font-mono fw-bold mb-2" style="font-size: 28px; color: #0B5563;">02</div>
                    <h3 class="fw-semibold mb-2" style="font-size: 20px; line-height: 28px; color: #0E1B24;">Get AI analysis & ideas</h3>
                    <p class="text-muted mb-0" style="font-size: 15px; line-height: 24px; color: #5B6670;">
                        See your capabilities, new product options and demand outlook.
                    </p>
                </div>
            </div>

            <!-- Step 03 -->
            <div class="col-md-4">
                <div class="card-induva h-100 d-flex flex-column text-start">
                    <div class="mb-3 text-center p-2 rounded-3">
                        <img src="~/images/landing/step-03-matching.webp" alt="Match and connect" class="img-fluid" style="max-height: 140px; object-fit: contain;" />
                    </div>
                    <div class="font-mono fw-bold mb-2" style="font-size: 28px; color: #0B5563;">03</div>
                    <h3 class="fw-semibold mb-2" style="font-size: 20px; line-height: 28px; color: #0E1B24;">Match and connect</h3>
                    <p class="text-muted mb-0" style="font-size: 15px; line-height: 24px; color: #5B6670;">
                        Reach suppliers, buyers and investors that fit &mdash; ranked by score and distance.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

