@{
    ViewData["Title"] = "Industry & Investment Development Platform for Egypt";
    ViewData["IsLandingPage"] = true;
}

<!-- SECTION 2: HERO -->
<section class="py-5" style="background-color: #F6F4EF; padding-top: 96px !important; padding-bottom: 72px !important;">
    <div class="container" style="max-width: 1200px;">
        <div class="row align-items-center g-5">
            <!-- Left Column (6 cols) -->
            <div class="col-lg-6">
                <span class="eyebrow mb-3 d-inline-block">EGYPT'S INDUSTRIAL NETWORK</span>
                <h1 class="display-headline mb-4" style="font-size: 56px; line-height: 60px; font-weight: 600; letter-spacing: -0.015em; color: #0E1B24;">
                    Turn idle capacity into new revenue.
                </h1>
                <p class="mb-4" style="font-size: 18px; line-height: 28px; color: #5B6670;">
                    INDUVA connects raw materials, factories, suppliers, buyers, startups and investors across Egypt &mdash; and uses AI to find products, partners and opportunities you can't see yet.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Factories" asp-action="Index" class="btn-primary-teal">Explore factories</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-secondary-white">Create free account</a>
                </div>
                <div class="d-flex align-items-center gap-2 small text-muted" style="color: #5B6670;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E7D5B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <span>Free to join &middot; Works for all 27 governorates</span>
                </div>
            </div>

            <!-- Right Column (6 cols) - Frameless, Generous Image -->
            <div class="col-lg-6 d-flex align-items-center justify-content-center justify-content-lg-end">
                <img src="~/images/landing/hero-factory.webp" alt="Egyptian Factory Processing" class="img-fluid" style="max-height: 480px; width: 100%; max-width: 580px; object-fit: contain; border: none; outline: none; box-shadow: none;" />
            </div>
        </div>
    </div>
</section>

