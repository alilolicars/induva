@model SupplierDetailsDto
@{
    ViewData["Title"] = Model.CompanyName;
    var rawMaterials = ViewBag.RawMaterials as IEnumerable<SelectListItem> ?? [];
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="fw-bold mb-0">@Model.CompanyName</h1>
                @if (!Model.IsPublic)
                {
                    <span class="badge bg-secondary">Private Profile</span>
                }
            </div>
            <p class="text-muted mb-0">
                <span>📍 @Model.GovernorateName</span>
                <span class="mx-2">·</span>
                <span>@Model.Materials.Count Supplied Material@(Model.Materials.Count == 1 ? "" : "s")</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.IsOwner)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit Profile</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to delete this supplier profile?');"
                      class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            }
            else if (!string.IsNullOrEmpty(Model.OwnerUserId))
            {
                <partial name="_ConnectButtonAndModal" model="@(new SendConnectionModalViewModel {
                    ToUserId = Model.OwnerUserId,
                    RelatedType = MatchEntityType.Supplier,
                    RelatedId = Model.Id,
                    TargetTitle = Model.CompanyName,
                    Message = $"Hello, I am interested in sourcing raw materials from {Model.CompanyName} through INDUVA."
                })" />
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body">
                <h6 class="fw-bold text-uppercase text-muted small mb-2">About Supplier</h6>
                <p class="mb-0 text-secondary">@Model.Description</p>
            </div>
        </div>
    }
</div>

<!-- Supplied Materials Section -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">📦 Available Materials & Feedstock (@Model.Materials.Count)</h5>
        @if (Model.IsOwner)
        {
            <button class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#addMaterialCollapse">
                + Add Material
            </button>
        }
    </div>
    <div class="card-body p-3">
        @if (Model.IsOwner)
        {
            <div class="collapse mb-3 p-3 bg-light rounded border" id="addMaterialCollapse">
                <h6 class="fw-bold small mb-2">Add Raw Material to Supply Catalog</h6>
                <form asp-action="AddMaterial" asp-route-id="@Model.Id" method="post">
                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <label class="form-label small mb-0">Raw Material</label>
                            <select name="RawMaterialId" class="form-select form-select-sm" required>
                                <option value="">Select Material...</option>
                                @foreach (var m in rawMaterials)
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small mb-0">Min Order (Tons)</label>
                            <input name="MinOrderTons" type="number" step="any" min="0" class="form-control form-control-sm" placeholder="Optional MOQ" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">Price / Supply Note</label>
                            <input name="PriceNote" class="form-control form-control-sm" placeholder="e.g. Spot market or FOB Alexandria" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Save to Catalog</button>
                </form>
            </div>
        }

        @if (Model.Materials.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <p class="mb-0">No raw materials listed in catalog yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Raw Material</th>
                            <th>Category</th>
                            <th>Min Order Quantity</th>
                            <th>Pricing / Supply Terms</th>
                            @if (Model.IsOwner) { <th style="width: 50px;"></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Materials)
                        {
                            <tr>
                                <td class="fw-semibold">@m.RawMaterialName</td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@m.Category</span></td>
                                <td>@(m.MinOrderTons.HasValue ? $"{m.MinOrderTons} Tons" : "Flexible")</td>
                                <td class="text-muted small">@(m.PriceNote ?? "-")</td>
                                @if (Model.IsOwner)
                                {
                                    <td>
                                        <form asp-action="RemoveMaterial" asp-route-id="@Model.Id" asp-route-materialId="@m.Id" method="post"
                                              onsubmit="return confirm('Remove @m.RawMaterialName from your catalog?');">
                                            <button type="submit" class="btn btn-link text-danger p-0" title="Remove">✕</button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

