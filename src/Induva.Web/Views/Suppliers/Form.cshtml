@model SupplierFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Supplier Profile" : "Register Supplier Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">@(isEdit ? "Edit Supplier Profile" : "Register Raw Material Supplier")</h4>
                <p class="text-muted small mb-0">Connect your supply chain capabilities with factories and industrial purchasers.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label fw-semibold"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Official business or company name" />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="GovernorateId" class="form-label fw-semibold"></label>
                            <select asp-for="GovernorateId" asp-items="Model.Governorates" class="form-select">
                                <option value="">Select Governorate...</option>
                            </select>
                            <span asp-validation-for="GovernorateId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Latitude" class="form-label fw-semibold"></label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" placeholder="e.g. 30.0444" />
                            <span asp-validation-for="Latitude" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Longitude" class="form-label fw-semibold"></label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" placeholder="e.g. 31.2357" />
                            <span asp-validation-for="Longitude" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Overview of extraction sites, processing facilities, logistics, certifications..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsPublic" class="form-check-input" type="checkbox" />
                        <label asp-for="IsPublic" class="form-check-label fw-semibold"></label>
                        <div class="form-text small">Public profiles appear on the marketplace directory and resource map.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">@(isEdit ? "Update Profile" : "Register Profile")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

