@model PagedResult<SupplierListItemDto>
@{
    ViewData["Title"] = "Raw Material Suppliers";
    var filter = ViewBag.Filter as SupplierFilter ?? new SupplierFilter();
    var governorates = ViewBag.Governorates as IEnumerable<SelectListItem> ?? [];
    var materials = ViewBag.RawMaterials as IEnumerable<SelectListItem> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold mb-1">Raw Material Suppliers</h1>
        <p class="text-muted mb-0">Browse certified local raw material extractors, recyclers, and industrial suppliers in Egypt.</p>
    </div>
    @if (User.IsInRole(Roles.Supplier) || User.IsInRole(Roles.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ Register Supplier Profile</a>
    }
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Search Company Name</label>
                <input type="text" name="Q" value="@filter.Q" class="form-control form-control-sm" placeholder="e.g. Sinai Gypsum, Nile Chemical..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Governorate</label>
                <select name="GovernorateId" class="form-select form-select-sm">
                    <option value="">All Governorates</option>
                    @foreach (var g in governorates)
                    {
                        <option value="@g.Value" selected="@(filter.GovernorateId?.ToString() == g.Value)">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Supplied Raw Material</label>
                <select name="RawMaterialId" class="form-select form-select-sm">
                    <option value="">All Raw Materials</option>
                    @foreach (var m in materials)
                    {
                        <option value="@m.Value" selected="@(filter.RawMaterialId?.ToString() == m.Value)">@m.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <div class="display-6 mb-2">📦</div>
        <h5 class="fw-bold">No suppliers found</h5>
        <p class="text-muted mb-3">Try adjusting your filters or search terms.</p>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Clear Filters</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var s in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 hover-lift">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">
                                <a asp-action="Details" asp-route-id="@s.Id" class="text-decoration-none text-dark stretched-link">
                                    @s.CompanyName
                                </a>
                            </h5>
                        </div>
                        <p class="text-muted small mb-2">📍 @s.GovernorateName</p>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
                            <span>📦 @s.MaterialCount Supplied Material@(s.MaterialCount == 1 ? "" : "s")</span>
                            <span class="text-primary fw-semibold">View Catalog &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@p"
                           asp-route-q="@filter.Q"
                           asp-route-governorateId="@filter.GovernorateId"
                           asp-route-rawMaterialId="@filter.RawMaterialId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

