@model StartupDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="fw-bold mb-0">@Model.Name</h1>
                <span class="badge bg-primary-subtle text-primary border">@Model.Sector</span>
                <span class="badge bg-light text-dark border">@Model.Stage</span>
            </div>
            <p class="text-muted mb-0">
                <span>📍 @Model.GovernorateName</span>
                @if (Model.FundingNeededEgp.HasValue)
                {
                    <span class="mx-2">·</span>
                    <span>Seeking: <strong class="text-success">@Model.FundingNeededEgp.Value.ToString("N0") EGP</strong></span>
                }
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.IsOwner)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit Startup</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to delete this startup profile?');"
                      class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            }
            else if (!string.IsNullOrEmpty(Model.OwnerUserId))
            {
                <partial name="_ConnectButtonAndModal" model="@(new SendConnectionModalViewModel {
                    ToUserId = Model.OwnerUserId,
                    RelatedType = MatchEntityType.Startup,
                    RelatedId = Model.Id,
                    TargetTitle = Model.Name,
                    Message = $"Hello, I am interested in exploring manufacturing partnership or investment with {Model.Name}."
                })" />
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <!-- Product Idea -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">💡 Product Concept & Innovation</h5>
            </div>
            <div class="card-body">
                <p class="mb-0 text-secondary" style="white-space: pre-line;">@Model.ProductIdea</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">📋 Background & Traction</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-secondary" style="white-space: pre-line;">@Model.Description</p>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Required Manufacturing Capabilities -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">⚙️ Required Capabilities</h6>
                <p class="text-muted small mb-0">Equipment & processes needed from factory partners</p>
            </div>
            <div class="card-body">
                @if (Model.RequiredTags.Count == 0)
                {
                    <p class="text-muted small mb-0">No specific equipment tags selected.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var tag in Model.RequiredTags)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">@tag</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Investment & Partnering Snapshot -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">🤝 Collaboration Needs</h6>
            </div>
            <div class="card-body small">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Target Sector</span>
                    <span class="fw-semibold">@Model.Sector</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Stage</span>
                    <span class="fw-semibold">@Model.Stage</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Funding Target</span>
                    <span class="fw-semibold text-success">@(Model.FundingNeededEgp.HasValue ? $"{Model.FundingNeededEgp.Value:N0} EGP" : "Equity/Contract")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Governorate</span>
                    <span class="fw-semibold">@Model.GovernorateName</span>
                </div>
            </div>
        </div>
    </div>
</div>

