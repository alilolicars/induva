@model PagedResult<StartupListItemDto>
@{
    ViewData["Title"] = "Industrial Startups";
    var filter = ViewBag.Filter as StartupFilter ?? new StartupFilter();
    var governorates = ViewBag.Governorates as IEnumerable<SelectListItem> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold mb-1">Industrial Startups</h1>
        <p class="text-muted mb-0">Discover emerging Egyptian hardware, product, and industrial tech startups seeking manufacturing partners and investment.</p>
    </div>
    @if (User.IsInRole(Roles.Startup) || User.IsInRole(Roles.Admin))
    {
        <a asp-action="Create" class="btn btn-primary">+ Register Startup</a>
    }
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Search Name</label>
                <input type="text" name="Q" value="@filter.Q" class="form-control form-control-sm" placeholder="e.g. Solar, Bioplastic..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Sector</label>
                <select name="Sector" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<Sector>()">
                    <option value="">All Sectors</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Stage</label>
                <select name="Stage" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<StartupStage>()">
                    <option value="">All Stages</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Governorate</label>
                <select name="GovernorateId" class="form-select form-select-sm">
                    <option value="">All Governorates</option>
                    @foreach (var g in governorates)
                    {
                        <option value="@g.Value" selected="@(filter.GovernorateId?.ToString() == g.Value)">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <div class="display-6 mb-2">💡</div>
        <h5 class="fw-bold">No startups found</h5>
        <p class="text-muted mb-3">Try adjusting your filters or search terms.</p>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Clear Filters</a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var s in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 hover-lift">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">
                                <a asp-action="Details" asp-route-id="@s.Id" class="text-decoration-none text-dark stretched-link">
                                    @s.Name
                                </a>
                            </h5>
                            <span class="badge bg-primary-subtle text-primary border">@s.Sector</span>
                        </div>
                        <p class="text-muted small mb-2">
                            <span>📍 @s.GovernorateName</span>
                            <span class="mx-1">·</span>
                            <span class="badge bg-light text-dark border">@s.Stage</span>
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top small text-muted">
                            <span>
                                @if (s.FundingNeededEgp.HasValue)
                                {
                                    <strong class="text-success">@s.FundingNeededEgp.Value.ToString("N0") EGP</strong> <span class="small">needed</span>
                                }
                                else
                                {
                                    <span>Seeking Manufacturing</span>
                                }
                            </span>
                            <span class="text-primary fw-semibold">Details &rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@p"
                           asp-route-q="@filter.Q"
                           asp-route-sector="@filter.Sector"
                           asp-route-stage="@filter.Stage"
                           asp-route-governorateId="@filter.GovernorateId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

