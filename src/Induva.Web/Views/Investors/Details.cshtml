@model InvestorDetailsDto
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">@Model.DisplayName</h1>
            <p class="text-muted mb-0">
                @if (Model.MinTicketEgp.HasValue || Model.MaxTicketEgp.HasValue)
                {
                    <span class="badge bg-success-subtle text-success border me-2">
                        Ticket: @(Model.MinTicketEgp?.ToString("N0") ?? "0") - @(Model.MaxTicketEgp?.ToString("N0") ?? "Flexible") EGP
                    </span>
                }
                <span>Industrial Investor & Partner</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.IsOwner)
            {
                <a asp-action="Manage" class="btn btn-outline-secondary btn-sm">Edit Profile</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Are you sure you want to remove your investor profile?');"
                      class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                </form>
            }
            else if (!string.IsNullOrEmpty(Model.OwnerUserId))
            {
                <partial name="_ConnectButtonAndModal" model="@(new SendConnectionModalViewModel {
                    ToUserId = Model.OwnerUserId,
                    RelatedType = MatchEntityType.Investor,
                    RelatedId = Model.Id,
                    TargetTitle = Model.DisplayName,
                    Message = $"Hello, I would like to introduce our project/factory to {Model.DisplayName} for investment and partnership."
                })" />
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Mandate & Bio -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">💼 Investment Mandate & Thesis</h5>
            </div>
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="text-muted mb-0">No detailed bio provided.</p>
                }
                else
                {
                    <p class="text-secondary mb-0" style="white-space: pre-line;">@Model.Bio</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Criteria -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">🎯 Sector Focus</h6>
            </div>
            <div class="card-body">
                @if (Model.Sectors.Count == 0)
                {
                    <p class="text-muted small mb-0">All industrial sectors considered.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var s in Model.Sectors)
                        {
                            <span class="badge bg-primary-subtle text-primary border">@s</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">🌱 Preferred Stages</h6>
            </div>
            <div class="card-body">
                @if (Model.PreferredStages.Count == 0)
                {
                    <p class="text-muted small mb-0">Open to all stages.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var stg in Model.PreferredStages)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">@stg</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

