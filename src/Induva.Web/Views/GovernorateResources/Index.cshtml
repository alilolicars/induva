@model IReadOnlyList<GovernorateResourceDto>
@{
    ViewData["Title"] = "Governorate Resources Directory";
    var governorates = ViewBag.Governorates as IEnumerable<SelectListItem> ?? [];
    var selectedGovId = ViewBag.SelectedGovernorateId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h2 fw-bold mb-1">🗺️ Governorate Natural Resources</h1>
        <p class="text-muted mb-0">Admin directory of regional raw material reserves and agricultural/mineral yields across Egyptian governorates.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Governorate Resource</a>
</div>

<!-- Filter by Governorate -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="governorateId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All 27 Governorates</option>
                    @foreach (var g in governorates)
                    {
                        <option value="@g.Value" selected="@(selectedGovId?.ToString() == g.Value)">@g.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <noscript><button type="submit" class="btn btn-sm btn-primary">Filter</button></noscript>
                @if (selectedGovId.HasValue)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Show All</a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5 bg-white rounded shadow-sm border">
        <div class="display-6 mb-2">⛏️</div>
        <h5 class="fw-bold">No resources recorded</h5>
        <p class="text-muted mb-3">Add regional raw material availability data to ground AI product suggestions.</p>
        <a asp-action="Create" class="btn btn-sm btn-primary">Add Resource</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Governorate</th>
                        <th>Raw Material</th>
                        <th>Category</th>
                        <th>Estimated Annual Yield</th>
                        <th>Notes / Localities</th>
                        <th style="width: 120px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.GovernorateName</td>
                            <td>@r.RawMaterialName</td>
                            <td><span class="badge bg-secondary-subtle text-secondary border">@r.Category</span></td>
                            <td>@(r.EstimatedAnnualTons.HasValue ? $"{r.EstimatedAnnualTons:N0} Tons/yr" : "Unspecified")</td>
                            <td class="text-muted small">@(r.Notes ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-link text-primary p-0 me-2">Edit</a>
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this resource entry?');">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

