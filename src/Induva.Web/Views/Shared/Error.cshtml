@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0 p-4">
            <div class="mb-3">
                @if (Model.StatusCode == 404)
                {
                    <span class="badge bg-secondary fs-6 py-2 px-3">404 · Not Found</span>
                }
                else if (Model.StatusCode == 403)
                {
                    <span class="badge bg-warning text-dark fs-6 py-2 px-3">403 · Forbidden</span>
                }
                else if (Model.StatusCode.HasValue && Model.StatusCode.Value >= 500)
                {
                    <span class="badge bg-danger fs-6 py-2 px-3">@Model.StatusCode · Server Error</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 py-2 px-3">Notice</span>
                }
            </div>

            <h2 class="fw-bold mb-3">@Model.Title</h2>
            <p class="text-muted mb-4">@Model.Message</p>

            @if (Model.ShowRequestId)
            {
                <div class="text-muted small mb-4">
                    Tracking Identifier: <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    Return to Home
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.history.back()">
                    Go Back
                </button>
            </div>
        </div>
    </div>
</div>
