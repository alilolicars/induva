@model FactoryAnalysisDto

<div class="card border-0 shadow-sm mt-3 bg-white">
    <div class="card-body p-4">
        <!-- Header & Cache badge -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Factory Capability Profile</h5>
                <small class="text-muted">Generated @Model.GeneratedAtUtc.ToString("MMM dd, yyyy HH:mm") UTC</small>
            </div>
            <div>
                @if (Model.FromCache)
                {
                    <span class="badge bg-secondary-subtle text-secondary border">⚡ Cached Result</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border">✓ Live Analysis</span>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Warning))
        {
            <div class="alert alert-warning py-2 small mb-3">
                ⚠️ @Model.Warning
            </div>
        }

        <!-- Summary -->
        <p class="fs-6 text-secondary mb-3">@Model.Summary</p>

        <!-- Standardized Capability Tags -->
        @if (Model.CapabilityTags.Count > 0)
        {
            <div class="mb-3">
                <h6 class="small fw-bold text-uppercase text-muted mb-2">Verified Capability Tags</h6>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var tag in Model.CapabilityTags)
                    {
                        <span class="badge bg-primary-subtle text-primary border px-2 py-1">@tag</span>
                    }
                </div>
            </div>
        }

        <!-- Process Capabilities -->
        @if (Model.Processes.Count > 0)
        {
            <div class="mb-3">
                <h6 class="small fw-bold text-uppercase text-muted mb-2">Process Capabilities</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Process Name</th>
                                <th>Utilized Machines</th>
                                <th>Processable Materials</th>
                                <th>Capacity Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Processes)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Name</td>
                                    <td>@string.Join(", ", p.Machines)</td>
                                    <td>@string.Join(", ", p.MaterialsProcessable)</td>
                                    <td class="text-muted">@(p.CapacityNote ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Strengths & Constraints -->
        <div class="row g-3 mb-3">
            @if (Model.Strengths.Count > 0)
            {
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border h-100">
                        <h6 class="small fw-bold text-success mb-2">💪 Operational Strengths</h6>
                        <ul class="mb-0 ps-3 small text-secondary">
                            @foreach (var s in Model.Strengths)
                            {
                                <li>@s</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (Model.Constraints.Count > 0)
            {
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded border h-100">
                        <h6 class="small fw-bold text-danger mb-2">⚠️ Operational Constraints</h6>
                        <ul class="mb-0 ps-3 small text-secondary">
                            @foreach (var c in Model.Constraints)
                            {
                                <li>@c</li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <!-- Underused Assets -->
        @if (Model.UnderusedAssets.Count > 0)
        {
            <div class="mb-3 p-3 bg-light rounded border">
                <h6 class="small fw-bold text-info-emphasis mb-2">💡 Underused Assets & Opportunities</h6>
                <ul class="mb-0 ps-3 small text-secondary">
                    @foreach (var u in Model.UnderusedAssets)
                    {
                        <li>@u</li>
                    }
                </ul>
            </div>
        }

        <!-- Missing Information (Recommendation to Owner) -->
        @if (Model.MissingInformation.Count > 0)
        {
            <div class="alert alert-warning py-2 mb-3">
                <h6 class="small fw-bold text-warning-emphasis mb-1">Add this information to improve accuracy:</h6>
                <ul class="mb-0 ps-3 small text-secondary">
                    @foreach (var m in Model.MissingInformation)
                    {
                        <li>@m</li>
                    }
                </ul>
            </div>
        }

        <!-- Confidence & Honest UX Disclaimer -->
        <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2" style="min-width: 220px;">
                <span class="small text-muted">Analysis Confidence:</span>
                <div class="progress flex-grow-1" style="height: 8px;">
                    <div class="progress-bar bg-primary" role="progressbar"
                         style="width: @((int)(Model.Confidence * 100))%"
                         aria-valuenow="@((int)(Model.Confidence * 100))" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span class="small fw-bold">@((int)(Model.Confidence * 100))%</span>
            </div>
            <div class="small text-muted fst-italic">
                AI-generated estimate based on your entered data. Review before relying on it.
            </div>
        </div>
    </div>
</div>

