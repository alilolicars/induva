@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en" class="@(ViewData["IsAuthPage"] as bool? == true ? "auth-page-html" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - INDUVA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100 @(ViewData["IsAuthPage"] as bool? == true ? "auth-page-body" : "")" style="background-color: #F6F4EF; color: #0E1B24;">
    <!-- Subtle Scroll Progress Bar for GSAP ScrollTrigger (hidden on non-scrollable auth pages) -->
    @if (ViewData["IsAuthPage"] as bool? != true)
    {
        <div id="scroll-progress-bar" style="position: fixed; top: 0; left: 0; height: 3px; background-color: #0B5563; width: 0%; z-index: 9999; pointer-events: none;"></div>
    }

    <!-- NAVBAR (Identical across all pages) -->
    <header class="sticky-top bg-white border-bottom" style="height: 64px; border-color: #E3DFD6 !important; z-index: 1020;">
        <div class="container h-100 d-flex align-items-center justify-content-between" style="max-width: 1200px;">
            <!-- Brand Logo (Gold Cogwheel Emblem & Wordmark) -->
            <a class="navbar-brand d-flex align-items-center text-decoration-none m-0 py-0" asp-controller="Home" asp-action="Index">
                <img src="~/images/landing/شعار إندوفا الصناعي بالعجلة الذهبية.webp" alt="INDUVA" style="height: 38px; width: auto; object-fit: contain;" />
            </a>

            <!-- Center Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-4" style="font-size: 15px; font-weight: 500;">
                <div class="dropdown">
                    <a class="text-decoration-none text-dark d-inline-flex align-items-center gap-1 dropdown-toggle" style="color: rgba(14,27,36,0.8) !important;" href="#" role="button" data-bs-toggle="dropdown">
                        Explore
                    </a>
                    <ul class="dropdown-menu shadow-sm border rounded-3 py-2" style="border-color: #E3DFD6;">
                        <li><a class="dropdown-item py-2" asp-controller="Factories" asp-action="Index">Factories</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Startups" asp-action="Index">Startups</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Investors" asp-action="Index">Investors</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2" asp-controller="DemandRequests" asp-action="Index">Demand & RFQs</a></li>
                    </ul>
                </div>
                <a class="text-decoration-none text-dark" style="color: rgba(14,27,36,0.8) !important;" asp-controller="Map" asp-action="Index">Map</a>
                <div class="dropdown">
                    <a class="text-decoration-none text-dark d-inline-flex align-items-center gap-1 dropdown-toggle" style="color: rgba(14,27,36,0.8) !important;" href="#" role="button" data-bs-toggle="dropdown">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#C96A2B" stroke-width="2"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
                        AI Tools
                    </a>
                    <ul class="dropdown-menu shadow-sm border rounded-3 py-2" style="border-color: #E3DFD6;">
                        <li><a class="dropdown-item py-2" asp-controller="DemandForecasts" asp-action="Index">Demand Forecast</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Matching" asp-action="Index">Matching</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Investments" asp-action="Index">Feasibility</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Right Actions (Logged Out / Logged In) -->
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="text-decoration-none text-dark small fw-medium" asp-controller="Connections" asp-action="Index">Connections</a>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-secondary-white dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            @(User.Identity.Name ?? "Account")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-3 py-2" style="border-color: #E3DFD6;">
                            <li><h6 class="dropdown-header">Role: @(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</h6></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="text-decoration-none fw-medium text-dark small px-2" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn-primary-teal" asp-controller="Account" asp-action="Register">Get started</a>
                }
            </div>
        </div>
    </header>

    <!-- CONTENT BODY -->
    @if (ViewData["IsLandingPage"] as bool? == true || ViewData["IsAuthPage"] as bool? == true)
    {
        @RenderBody()
    }
    else
    {
        <main role="main" class="container py-4 flex-grow-1" style="max-width: 1200px;">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <span>✓ @TempData["Success"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <span>⚠ @TempData["Error"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    }

    <!-- FOOTER (Identical across all pages, hidden on auth pages) -->
    @if (ViewData["HideFooter"] as bool? != true)
    {
        <footer class="bg-white border-top py-5 mt-auto" style="border-color: #E3DFD6 !important;">
            <div class="container" style="max-width: 1200px;">
                <div class="row g-4 mb-4">
                    <div class="col-lg-5">
                        <div class="mb-2">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-inline-block">
                                <img src="~/images/landing/شعار إندوفا الصناعي بالعجلة الذهبية.webp" alt="INDUVA" style="height: 42px; width: auto; object-fit: contain;" />
                            </a>
                        </div>
                        <p class="text-muted small mb-0" style="color: #5B6670;">Industry & Investment Development Platform for Egypt</p>
                    </div>
                    <div class="col-6 col-lg-2 offset-lg-1">
                        <h6 class="fw-semibold small text-uppercase mb-3" style="color: #0E1B24; letter-spacing: 0.08em; font-size: 12px;">Platform</h6>
                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-2" style="color: #5B6670;">
                            <li><a class="text-decoration-none text-muted" asp-controller="Factories" asp-action="Index">Factories</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Startups" asp-action="Index">Startups</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Investors" asp-action="Index">Investors</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="DemandRequests" asp-action="Index">Demand & RFQs</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h6 class="fw-semibold small text-uppercase mb-3" style="color: #0E1B24; letter-spacing: 0.08em; font-size: 12px;">AI Tools</h6>
                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-2" style="color: #5B6670;">
                            <li><a class="text-decoration-none text-muted" asp-controller="DemandForecasts" asp-action="Index">Demand Forecast</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Matching" asp-action="Index">Matching</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Investments" asp-action="Index">Feasibility</a></li>
                        </ul>
                    </div>
                    <div class="col-6 col-lg-2">
                        <h6 class="fw-semibold small text-uppercase mb-3" style="color: #0E1B24; letter-spacing: 0.08em; font-size: 12px;">Account</h6>
                        <ul class="list-unstyled small mb-0 d-flex flex-column gap-2" style="color: #5B6670;">
                            <li><a class="text-decoration-none text-muted" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li><a class="text-decoration-none text-muted" asp-controller="Account" asp-action="Register">Create account</a></li>
                        </ul>
                    </div>
                </div>
                <div class="pt-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: #E3DFD6 !important;">
                    <span class="small text-muted" style="color: #8A949C !important;">&copy; 2026 INDUVA</span>
                    <span class="small text-muted" style="color: #8A949C !important;">AI-generated estimates are indicative only and are not financial advice.</span>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- GSAP & Scroll Plugins -->
    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js"></script>
    <script src="~/lib/gsap/ScrollToPlugin.min.js"></script>
    <script src="~/js/scroll-animations.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ai-actions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
