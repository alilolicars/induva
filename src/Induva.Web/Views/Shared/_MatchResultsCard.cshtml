@model MatchingSummaryDto

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h5 class="fw-bold mb-0 text-primary">🎯 Top Matches for @Model.SourceTitle</h5>
                @if (Model.AiUsed)
                {
                    <span class="badge bg-success-subtle text-success border">✓ AI Re-ranked</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border">Rules Only</span>
                }
            </div>
            <p class="small text-muted mb-0">Target: @Model.TargetType Opportunities · Scored by capability overlap, proximity, and operational fit</p>
        </div>
        <small class="text-muted">@Model.GeneratedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</small>
    </div>
    <div class="card-body p-4">
        @if (Model.Matches.Count == 0)
        {
            <div class="text-center py-4 text-muted">
                <div class="display-6 mb-2">🔍</div>
                <h6 class="fw-bold">No matching opportunities found</h6>
                <p class="small mb-0">Try expanding your capability tags or register additional materials/needs.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var m in Model.Matches)
                {
                    <div class="card border rounded shadow-xs p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">@m.Title</h5>
                                <div class="small text-muted">
                                    <span>@m.Subtitle</span>
                                    @if (!string.IsNullOrEmpty(m.Location))
                                    {
                                        <span>· 📍 @m.Location</span>
                                    }
                                    @if (m.DistanceKm > 0)
                                    {
                                        <span>(@m.DistanceKm.ToString("N0") km away)</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4 fw-bold @(m.FinalScore >= 75 ? "text-success" : m.FinalScore >= 50 ? "text-primary" : "text-secondary")">
                                        @m.FinalScore.ToString("F1")
                                    </span>
                                    <span class="small text-muted">/ 100</span>
                                </div>
                                <span class="badge bg-light text-muted border small">
                                    Rule: @m.RuleScore.ToString("F0")
                                    @if (m.FinalScore != m.RuleScore)
                                    {
                                        <span> · AI: @((m.FinalScore - m.RuleScore) > 0 ? "+" : "")@((m.FinalScore - m.RuleScore).ToString("F1"))</span>
                                    }
                                </span>
                            </div>
                        </div>

                        <!-- Match reasons -->
                        <div class="bg-light rounded p-2 small mb-2">
                            <span class="fw-bold text-muted d-block mb-1">Fit Highlights:</span>
                            <ul class="mb-0 ps-3 text-secondary">
                                @foreach (var r in m.Reasons)
                                {
                                    <li>@r</li>
                                }
                            </ul>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(m.NextStep))
                        {
                            <div class="small text-muted mb-3">
                                💡 <strong>Recommended Next Step:</strong> @m.NextStep
                            </div>
                        }

                        <!-- Action button -->
                        <div class="d-flex justify-content-end pt-2 border-top">
                            @if (!string.IsNullOrEmpty(m.TargetOwnerUserId))
                            {
                                <partial name="_ConnectButtonAndModal" model="@(new SendConnectionModalViewModel {
                                    ToUserId = m.TargetOwnerUserId,
                                    RelatedType = Model.TargetType,
                                    RelatedId = m.Id,
                                    TargetTitle = m.Title,
                                    Message = $"Hello, INDUVA's Opportunity Matcher recommended a strong alignment ({m.FinalScore:F0}% fit) between {Model.SourceTitle} and {m.Title}."
                                })" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

