@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Verify Code & Reset Password";
    ViewData["IsAuthPage"] = true;
    ViewData["HideFooter"] = true;
}

@section Head {
    <style>
        html, body {
            height: 100vh !important;
            max-height: 100vh !important;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    </style>
}

<div class="container-fluid p-0 d-flex flex-column flex-lg-row auth-viewport-container">
    <!-- LEFT PANEL: Security & Artwork -->
    <div class="col-12 col-lg-6 position-relative d-flex flex-column justify-content-between overflow-hidden" 
         style="background-color: #0E1B24; height: 100%; padding: clamp(20px, 3.8vh, 48px) clamp(24px, 4.2vw, 56px) clamp(16px, 2vh, 28px) clamp(24px, 4.2vw, 56px);">
        
        <!-- Topographic Contour Accents -->
        <svg class="position-absolute top-0 start-0 pointer-events-none" style="width: 440px; height: 440px; opacity: 0.28; pointer-events: none;" viewBox="0 0 400 400" fill="none" stroke="#4EA5B3" stroke-width="1.2">
            <path d="M-60,50 C80,20 160,110 180,240 C190,320 280,380 440,400" />
            <path d="M-60,100 C90,70 180,150 210,290 C220,350 300,410 440,430" />
            <path d="M-60,150 C110,120 200,200 240,340 C250,390 320,440 440,460" />
            <path d="M-60,200 C130,170 220,250 270,390" />
        </svg>

        <!-- Recovery Content -->
        <div class="position-relative" style="z-index: 2; max-width: 520px;">
            <div class="text-uppercase fw-bold mb-2" style="color: #64A7B3; font-size: 13px; letter-spacing: 0.14em;">VERIFY &amp; RESET</div>
            <h1 class="text-white fw-bold" style="font-size: clamp(26px, 2.7vw, 36px); line-height: 1.15; letter-spacing: -0.02em; margin-bottom: clamp(12px, 2vh, 22px);">Enter your 6-digit<br />verification code.</h1>
            
            <div class="d-flex flex-column" style="gap: clamp(8px, 1.4vh, 14px); font-size: clamp(13px, 1.05vw, 15px); color: #E8ECEF; margin-bottom: clamp(10px, 1.8vh, 18px);">
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Check your email inbox for the 6-digit code</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Single-use code expires in 15 minutes</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Set a strong new password with at least 8 characters</span>
                </div>
            </div>
        </div>

        <!-- Lower Isometric Network Illustration -->
        <div class="position-relative text-center d-flex justify-content-center align-items-end mt-auto" style="z-index: 2;">
            <img src="~/images/auth/login_side_image.webp" alt="INDUVA Industrial Network" class="img-fluid auth-side-artwork" style="max-height: clamp(170px, 33vh, 320px); width: auto; object-fit: contain;" />
        </div>
    </div>

    <!-- RIGHT PANEL: Reset Card -->
    <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center overflow-hidden" 
         style="background-color: #F6F4EF; height: 100%; padding: clamp(14px, 2.5vh, 28px) clamp(16px, 2vw, 32px);">
        
        <div class="bg-white rounded-4 border auth-card" 
             style="width: 440px; max-width: 100%; border-color: #E3DFD6 !important; padding: clamp(20px, 3vh, 36px) clamp(22px, 3vw, 36px); box-shadow: 0 4px 24px rgba(14, 27, 36, 0.04), 0 1px 3px rgba(14, 27, 36, 0.02) !important;">
            
            <h2 class="fw-bold mb-1" style="font-size: clamp(22px, 2.3vh, 28px); color: #0E1B24; letter-spacing: -0.01em;">Reset password</h2>
            <p class="small" style="color: #5B6670; font-size: clamp(12.5px, 1.3vh, 14px); margin-bottom: clamp(12px, 1.8vh, 18px);">
                Enter the 6-digit code sent to <strong class="text-dark">@Model.Email</strong>
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 small mb-2" role="alert">
                    <span>✓ @TempData["Success"]</span>
                </div>
            }

            <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
                <input type="hidden" asp-for="Email" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-2" role="alert"></div>
                }

                <!-- OTP Input (6 digits, monospace, centered) -->
                <div class="mb-2 mb-sm-3">
                    <label asp-for="Otp" class="form-label fw-semibold" style="font-size: 13px; color: #0E1B24; margin-bottom: 5px;">Verification Code (OTP)</label>
                    <div class="position-relative">
                        <input asp-for="Otp" maxlength="6" autofocus autocomplete="one-time-code" class="form-control font-mono text-center fw-bold" placeholder="• • • • • •" style="font-size: 24px; letter-spacing: 0.32em; height: clamp(40px, 4.6vh, 46px); border-color: #0B5563; color: #0B5563;" />
                    </div>
                    <span asp-validation-for="Otp" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <!-- New Password Input -->
                <div class="mb-2 mb-sm-3">
                    <label asp-for="Password" class="form-label fw-semibold" style="font-size: 13px; color: #0E1B24; margin-bottom: 5px;">New Password</label>
                    <div class="position-relative">
                        <span class="position-absolute d-flex align-items-center" style="left: 14px; top: 0; bottom: 0; pointer-events: none; color: #8A949C;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input asp-for="Password" type="password" id="newPasswordField" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" style="height: clamp(38px, 4.4vh, 44px); padding-left: 42px; padding-right: 42px; border-color: #D5D0C5; border-radius: 8px; font-size: 14px; color: #0E1B24;" />
                        <button type="button" id="toggleNewPasswordBtn" class="btn p-0 position-absolute d-flex align-items-center border-0 bg-transparent" style="right: 14px; top: 0; bottom: 0; color: #8A949C;" title="Toggle visibility">
                            <svg id="eyeIconNew" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Confirm Password Input -->
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="font-size: 13px; color: #0E1B24; margin-bottom: 5px;">Confirm New Password</label>
                    <div class="position-relative">
                        <span class="position-absolute d-flex align-items-center" style="left: 14px; top: 0; bottom: 0; pointer-events: none; color: #8A949C;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordField" class="form-control" autocomplete="new-password" placeholder="Repeat your new password" style="height: clamp(38px, 4.4vh, 44px); padding-left: 42px; padding-right: 42px; border-color: #D5D0C5; border-radius: 8px; font-size: 14px; color: #0E1B24;" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Submit Button -->
                <div class="d-grid mb-2 mb-sm-3">
                    <button type="submit" class="btn text-white w-100" style="background-color: #0B5563; height: clamp(40px, 4.6vh, 46px); border-radius: 8px; font-weight: 600; font-size: 15px; border: none; transition: background-color 0.15s ease-in-out;" onmouseover="this.style.backgroundColor='#094651'" onmouseout="this.style.backgroundColor='#0B5563'">
                        Reset Password
                    </button>
                </div>

                <!-- Resend Row -->
                <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top" style="border-color: #E3DFD6 !important; font-size: 13px;">
                    <span style="color: #5B6670;">Didn't get the code?</span>
                    <button type="submit" form="resendOtpForm" class="btn btn-link p-0 text-decoration-none fw-semibold" style="color: #0B5563; font-size: 13px;">Resend Code</button>
                </div>

                <div class="text-center mt-2" style="font-size: 12.5px;">
                    <a asp-action="ForgotPassword" style="color: #5B6670; text-decoration: none;">&larr; Use a different email address</a>
                </div>
            </form>

            <form asp-action="ResendOtp" method="post" id="resendOtpForm" class="d-none">
                <input type="hidden" name="email" value="@Model.Email" />
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('toggleNewPasswordBtn');
            const pwdInput = document.getElementById('newPasswordField');
            const eyeIcon = document.getElementById('eyeIconNew');
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', function () {
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        eyeIcon.innerHTML = '<path d="m2 2 20 20"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>';
                    } else {
                        pwdInput.type = 'password';
                        eyeIcon.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
                    }
                });
            }

            if (typeof gsap !== 'undefined') {
                gsap.from('.auth-card', { opacity: 0, y: 18, duration: 0.65, ease: 'power2.out' });
                gsap.from('.auth-side-artwork', { opacity: 0, scale: 0.95, duration: 0.8, ease: 'power2.out', delay: 0.1 });
            }
        });
    </script>
}
