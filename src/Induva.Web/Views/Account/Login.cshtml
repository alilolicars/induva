@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["IsAuthPage"] = true;
    ViewData["HideFooter"] = true;
}

@section Head {
    <style>
        html, body {
            height: 100vh !important;
            max-height: 100vh !important;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    </style>
}

<div class="container-fluid p-0 d-flex flex-column flex-lg-row auth-viewport-container">
    <!-- LEFT PANEL: Brand, Value Proposition & Isometric Network Illustration -->
    <div class="col-12 col-lg-6 position-relative d-flex flex-column justify-content-between overflow-hidden" 
         style="background-color: #0E1B24; height: 100%; padding: clamp(20px, 3.8vh, 48px) clamp(24px, 4.2vw, 56px) clamp(16px, 2vh, 28px) clamp(24px, 4.2vw, 56px);">
        
        <!-- Topographic Contour Accents (faint teal vector lines) -->
        <svg class="position-absolute top-0 start-0 pointer-events-none" style="width: 440px; height: 440px; opacity: 0.28; pointer-events: none;" viewBox="0 0 400 400" fill="none" stroke="#4EA5B3" stroke-width="1.2">
            <path d="M-60,50 C80,20 160,110 180,240 C190,320 280,380 440,400" />
            <path d="M-60,100 C90,70 180,150 210,290 C220,350 300,410 440,430" />
            <path d="M-60,150 C110,120 200,200 240,340 C250,390 320,440 440,460" />
            <path d="M-60,200 C130,170 220,250 270,390" />
        </svg>
        <svg class="position-absolute bottom-0 end-0 pointer-events-none" style="width: 360px; height: 360px; opacity: 0.22; pointer-events: none;" viewBox="0 0 350 350" fill="none" stroke="#4EA5B3" stroke-width="1.2">
            <path d="M-20,360 C120,330 220,260 250,150 C270,70 330,30 380,0" />
            <path d="M40,380 C160,350 250,290 280,190 C300,120 350,70 400,40" />
            <path d="M100,400 C200,370 280,320 310,230" />
        </svg>

        <!-- Value Proposition Content -->
        <div class="position-relative" style="z-index: 2; max-width: 520px;">
            <div class="text-uppercase fw-bold mb-2" style="color: #64A7B3; font-size: 13px; letter-spacing: 0.14em;">WELCOME BACK</div>
            <h1 class="text-white fw-bold" style="font-size: clamp(26px, 2.7vw, 36px); line-height: 1.15; letter-spacing: -0.02em; margin-bottom: clamp(12px, 2vh, 22px);">Your factory network<br />is waiting.</h1>
            
            <div class="d-flex flex-column" style="gap: clamp(8px, 1.4vh, 14px); font-size: clamp(13px, 1.05vw, 15px); color: #E8ECEF; margin-bottom: clamp(10px, 1.8vh, 18px);">
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Pick up your AI analyses where you left off</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Review new matches and connection requests</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Keep your profile and demand requests up to date</span>
                </div>
            </div>
        </div>

        <!-- Lower Isometric Network Illustration -->
        <div class="position-relative text-center d-flex justify-content-center align-items-end mt-auto" style="z-index: 2;">
            <img src="~/images/auth/login_side_image.webp" alt="INDUVA Industrial Network" class="img-fluid login-side-artwork" style="max-height: clamp(170px, 33vh, 320px); width: auto; object-fit: contain;" />
        </div>
    </div>

    <!-- RIGHT PANEL: Centered Sign In Card -->
    <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center overflow-hidden" 
         style="background-color: #F6F4EF; height: 100%; padding: clamp(14px, 2.5vh, 28px) clamp(16px, 2vw, 32px);">
        
        <div class="bg-white rounded-4 border signin-glass-card" 
             style="width: 440px; max-width: 100%; border-color: #E3DFD6 !important; padding: clamp(20px, 3vh, 36px) clamp(22px, 3vw, 36px); box-shadow: 0 4px 24px rgba(14, 27, 36, 0.04), 0 1px 3px rgba(14, 27, 36, 0.02) !important;">
            
            <h2 class="fw-bold mb-1" style="font-size: clamp(22px, 2.3vh, 28px); color: #0E1B24; letter-spacing: -0.01em;">Sign in</h2>
            <p class="small" style="color: #5B6670; font-size: clamp(12.5px, 1.3vh, 14px); margin-bottom: clamp(12px, 1.8vh, 20px);">Enter your details to access your INDUVA account.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-2" role="alert"></div>
            }

            <form asp-action="Login" method="post" id="loginForm">
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Email Input -->
                <div class="mb-2 mb-sm-3">
                    <label asp-for="Email" class="form-label fw-semibold" style="font-size: 13px; color: #0E1B24; margin-bottom: 5px;">Email</label>
                    <div class="position-relative">
                        <span class="position-absolute d-flex align-items-center" style="left: 14px; top: 0; bottom: 0; pointer-events: none; color: #8A949C;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        </span>
                        <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@company.com" autofocus style="height: clamp(38px, 4.4vh, 44px); padding-left: 42px; border-color: #D5D0C5; border-radius: 8px; font-size: 14px; color: #0E1B24;" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password Input -->
                <div class="mb-2 mb-sm-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-semibold mb-0" style="font-size: 13px; color: #0E1B24;">Password</label>
                        <a asp-action="ForgotPassword" class="small text-decoration-none" style="color: #0B5563; font-weight: 500; font-size: 13px;">Forgot password?</a>
                    </div>
                    <div class="position-relative">
                        <span class="position-absolute d-flex align-items-center" style="left: 14px; top: 0; bottom: 0; pointer-events: none; color: #8A949C;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input asp-for="Password" type="password" id="passwordField" class="form-control" autocomplete="current-password" placeholder="••••••••" style="height: clamp(38px, 4.4vh, 44px); padding-left: 42px; padding-right: 42px; border-color: #D5D0C5; border-radius: 8px; font-size: 14px; color: #0E1B24;" />
                        <button type="button" id="togglePasswordBtn" class="btn p-0 position-absolute d-flex align-items-center border-0 bg-transparent" style="right: 14px; top: 0; bottom: 0; color: #8A949C;" title="Toggle password visibility">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Remember Me Checkbox -->
                <div class="mb-3 form-check d-flex align-items-center gap-2">
                    <input asp-for="RememberMe" class="form-check-input mt-0" id="rememberMeCheck" style="border-color: #D5D0C5; width: 16px; height: 16px; cursor: pointer;" />
                    <label asp-for="RememberMe" class="form-check-label" for="rememberMeCheck" style="font-size: 13px; color: #0E1B24; cursor: pointer;">Keep me signed in</label>
                </div>

                <!-- Primary Submit Button -->
                <div class="d-grid mb-2 mb-sm-3">
                    <button type="submit" class="btn text-white w-100" style="background-color: #0B5563; height: clamp(40px, 4.6vh, 46px); border-radius: 8px; font-weight: 600; font-size: 15px; border: none; transition: background-color 0.15s ease-in-out;" onmouseover="this.style.backgroundColor='#094651'" onmouseout="this.style.backgroundColor='#0B5563'">Sign in</button>
                </div>

                <!-- Create Account Link -->
                <div class="text-center pt-2 pt-sm-3 border-top" style="border-color: #E3DFD6 !important; font-size: 13.5px; color: #5B6670;">
                    New to INDUVA? <a asp-action="Register" style="color: #0B5563; font-weight: 600; text-decoration: none;">Create an account</a>
                </div>

                <!-- Privacy & Data Protection Guarantee -->
                <div class="d-flex align-items-start justify-content-center gap-2 mt-3 pt-1 text-center" style="color: #8A949C; font-size: 11.5px; line-height: 1.45;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#8A949C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" style="margin-top: 1px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    <span>Your data stays on INDUVA. We never share contact details without your approval.</span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Password toggle
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const pwdInput = document.getElementById('passwordField');
            const eyeIcon = document.getElementById('eyeIcon');
            if (toggleBtn && pwdInput) {
                toggleBtn.addEventListener('click', function () {
                    if (pwdInput.type === 'password') {
                        pwdInput.type = 'text';
                        eyeIcon.innerHTML = '<path d="m2 2 20 20"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>';
                    } else {
                        pwdInput.type = 'password';
                        eyeIcon.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
                    }
                });
            }

            // GSAP entrance on non-scrollable login screen
            if (typeof gsap !== 'undefined') {
                gsap.from('.signin-glass-card', {
                    opacity: 0,
                    y: 18,
                    duration: 0.65,
                    ease: 'power2.out'
                });
                gsap.from('.login-side-artwork', {
                    opacity: 0,
                    scale: 0.95,
                    duration: 0.8,
                    ease: 'power2.out',
                    delay: 0.1
                });
            }
        });
    </script>
}
