@{
    ViewData["Title"] = "Password Reset Successful";
    ViewData["IsAuthPage"] = true;
    ViewData["HideFooter"] = true;
}

@section Head {
    <style>
        html, body {
            height: 100vh !important;
            max-height: 100vh !important;
            overflow: hidden !important;
            margin: 0 !important;
            padding: 0 !important;
        }
    </style>
}

<div class="container-fluid p-0 d-flex flex-column flex-lg-row auth-viewport-container">
    <!-- LEFT PANEL: Security & Artwork -->
    <div class="col-12 col-lg-6 position-relative d-flex flex-column justify-content-between overflow-hidden" 
         style="background-color: #0E1B24; height: 100%; padding: clamp(20px, 3.8vh, 48px) clamp(24px, 4.2vw, 56px) clamp(16px, 2vh, 28px) clamp(24px, 4.2vw, 56px);">
        
        <!-- Topographic Contour Accents -->
        <svg class="position-absolute top-0 start-0 pointer-events-none" style="width: 440px; height: 440px; opacity: 0.28; pointer-events: none;" viewBox="0 0 400 400" fill="none" stroke="#4EA5B3" stroke-width="1.2">
            <path d="M-60,50 C80,20 160,110 180,240 C190,320 280,380 440,400" />
            <path d="M-60,100 C90,70 180,150 210,290 C220,350 300,410 440,430" />
            <path d="M-60,150 C110,120 200,200 240,340 C250,390 320,440 440,460" />
            <path d="M-60,200 C130,170 220,250 270,390" />
        </svg>

        <!-- Content -->
        <div class="position-relative" style="z-index: 2; max-width: 520px;">
            <div class="text-uppercase fw-bold mb-2" style="color: #64A7B3; font-size: 13px; letter-spacing: 0.14em;">ACCOUNT SECURED</div>
            <h1 class="text-white fw-bold" style="font-size: clamp(26px, 2.7vw, 36px); line-height: 1.15; letter-spacing: -0.02em; margin-bottom: clamp(12px, 2vh, 22px);">Your password has<br />been updated.</h1>
            
            <p style="color: #E8ECEF; font-size: 15px; line-height: 1.6;">
                Your account credentials have been updated securely. You can now use your new password to access all factory tools, capacity matching, and AI recommendations.
            </p>
        </div>

        <!-- Lower Isometric Network Illustration -->
        <div class="position-relative text-center d-flex justify-content-center align-items-end mt-auto" style="z-index: 2;">
            <img src="~/images/auth/login_side_image.webp" alt="INDUVA Industrial Network" class="img-fluid auth-side-artwork" style="max-height: clamp(170px, 33vh, 320px); width: auto; object-fit: contain;" />
        </div>
    </div>

    <!-- RIGHT PANEL: Success Card -->
    <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center overflow-hidden" 
         style="background-color: #F6F4EF; height: 100%; padding: clamp(14px, 2.5vh, 28px) clamp(16px, 2vw, 32px);">
        
        <div class="bg-white rounded-4 border auth-card text-center" 
             style="width: 440px; max-width: 100%; border-color: #E3DFD6 !important; padding: clamp(24px, 3.5vh, 40px) clamp(22px, 3vw, 36px); box-shadow: 0 4px 24px rgba(14, 27, 36, 0.04), 0 1px 3px rgba(14, 27, 36, 0.02) !important;">
            
            <!-- Success Icon -->
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 56px; height: 56px; background-color: #E4F2EB; color: #2E7D5B;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>

            <h2 class="fw-bold mb-2" style="font-size: clamp(22px, 2.3vh, 28px); color: #0E1B24; letter-spacing: -0.01em;">Password reset complete</h2>
            
            <p class="small mb-4" style="color: #5B6670; font-size: 14px; line-height: 1.55;">
                Your password has been changed successfully. You can now sign in to your INDUVA account.
            </p>

            <div class="d-grid mb-3">
                <a asp-action="Login" class="btn text-white" style="background-color: #0B5563; height: clamp(40px, 4.6vh, 46px); border-radius: 8px; font-weight: 600; font-size: 15px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                    Sign in with new password
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof gsap !== 'undefined') {
                gsap.from('.auth-card', { opacity: 0, y: 18, duration: 0.65, ease: 'power2.out' });
                gsap.from('.auth-side-artwork', { opacity: 0, scale: 0.95, duration: 0.8, ease: 'power2.out', delay: 0.1 });
            }
        });
    </script>
}

